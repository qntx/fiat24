{
  "name": "@qntx/fiat24-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/fiat24.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "abi": "bun scripts/abi.ts",
    "gen": "bun scripts/gen.ts",
    "lint": "vp check && bun scripts/check-version.ts && bun scripts/gen.ts --check && bun run vectors --check",
    "typecheck": "vp run -r typecheck && tsc --noEmit",
    "build": "vp run -r build",
    "test": "vp run -r test && vp test",
    "check:pkg": "vp run @qntx/fiat24#check:pkg",
    "smoke:hermes": "bun run --cwd packages/fiat24 smoke:hermes",
    "vectors": "bun packages/fiat24/scripts/vectors/all.ts",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "viem": "2.58.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
